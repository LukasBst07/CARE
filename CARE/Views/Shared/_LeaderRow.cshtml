@model (ClassroomLiveVm Cls, int Rank)
@{
    var cls = Model.Cls;
    var rank = Model.Rank;
    var medal = rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}" };
    var scoreColor = cls.TotalScore >= 80 ? "#00ff88"
                   : cls.TotalScore >= 60 ? "#00e5ff"
                   : cls.TotalScore >= 40 ? "#ff8c00" : "#ff2d55";
}

<a href="/Classroom/Detail/@cls.Name" class="leader-row @(rank == 1 ? "leader-row-first" : "")"
   style="@(rank == 1 ? $"background:{cls.RankColor}0a;border-color:{cls.RankColor}33" : "")">

  <div class="lr-rank font-display">@medal</div>

  <div class="lr-name-group">
    <span class="lr-name font-display">@cls.Name</span>
    <span class="lr-status font-mono @(cls.Online ? "text-green" : "text-red")">
      @(cls.Online ? "● LIVE" : "○ OFFLINE")
    </span>
  </div>

  <div class="lr-bar-wrap">
    <div class="lr-bar" style="width:@cls.TotalScore%;background:linear-gradient(90deg,@(scoreColor)88,@scoreColor)">
      <span class="lr-bar-label font-mono">@cls.TotalScore pts</span>
    </div>
  </div>

  <div class="lr-sensors font-mono">
    <span title="CO₂">🌫 @cls.Eco2.ToString("F0")</span>
    <span title="Temp">🌡 @cls.Temp.ToString("F1")</span>
    <span title="Humidity">💧 @cls.Humidity.ToString("F0")%</span>
    <span title="Noise">🔊 @cls.Db.ToString("F0")</span>
    <span title="Light">💡 @cls.Lux.ToString("F0")</span>
  </div>

  <div class="lr-score-wrap">
    <span class="lr-score font-display" style="color:@scoreColor">@cls.TotalScore</span>
    <span class="font-mono text-dim">/ 100</span>
  </div>
</a>
